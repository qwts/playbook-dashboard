# Local HTTPS (never commit real passphrase values)
# Prefer letting `npm run dev` load the passphrase file into this env var.
# DASHBOARD_TLS_KEY_PASSPHRASE=
# DASHBOARD_TLS_KEY_PASSPHRASE_FILE=$HOME/.quorum/certs/key.passphrase
# DASHBOARD_TLS_CERTS_DIR=$HOME/.quorum/certs
# DASHBOARD_TLS_CERT=$HOME/.quorum/certs/fullchain.pem
# DASHBOARD_TLS_KEY=$HOME/.quorum/certs/key.pem
# DASHBOARD_DEV_BIND=127.0.0.1
# DASHBOARD_DEV_PORT=8443
# Browse at https://local.dev.zts1.com:8443/ (hosts → 127.0.0.1)

# Auth bypass for local SPA work. `npm run dev` defaults this to 1 because the
# /auth/* endpoints live in the Cloudflare Worker, not in Vite. Set to 0 and run
# `PAGES_ORIGIN=https://local.dev.zts1.com:8443 npm run dev` inside
# workers/dashboard-auth to exercise the real Apple/Google/GitHub flow.
# VITE_AUTH_DISABLED=1
