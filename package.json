{
  "name": "playbook-dashboard",
  "version": "0.1.0",
  "private": true,
  "description": "Public redacted fleet dashboard for qwts governed repositories",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "node scripts/dev.mjs preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "node --test \"src/**/*.test.ts\" \"tools/**/*.test.mjs\"",
    "collect": "node tools/collect.mjs",
    "ci": "npm run typecheck && npm test && npm run validate && npm run build",
    "validate": "node tools/validate-snapshot.mjs"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "terser": "^5.49.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  }
}
